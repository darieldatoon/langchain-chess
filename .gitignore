# local plans, never committed
plans/

# javascript
node_modules/

# python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
credentials.json

.DS_Store

# coverage
.coverage
.coverage.*
htmlcov/

# the web build lives inside the server package so the image can serve it; CI builds it
/apps/server/langchain_chess_server/static/
/apps/web/coverage/
/packages/*/coverage/

# the review app's LangSmith link; CI writes it from the CUSTOM_APP_ID variable
/apps/review/.langsmith/

# local dev server state (langgraph dev)
/.langgraph_api/

# fastchess match output (mise run test:uci)
/.uci-match/

# pytest-textual-snapshot failure report
/snapshot_report.html
