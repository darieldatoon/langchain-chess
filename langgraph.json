{
  "$schema": "https://langgra.ph/schema.json",
  "python_version": "3.13",
  "image_distro": "wolfi",
  "source": {
    "kind": "uv",
    "root": ".",
    "package": "langchain-chess-server"
  },
  "dockerfile_lines": [
    "ADD libs/chess/pyproject.toml /tmp/uv_export/project/libs/chess/pyproject.toml",
    "ADD libs/systemone/pyproject.toml /tmp/uv_export/project/libs/systemone/pyproject.toml",
    "ADD libs/cli/pyproject.toml /tmp/uv_export/project/libs/cli/pyproject.toml",
    "ADD apps/server/pyproject.toml /tmp/uv_export/project/apps/server/pyproject.toml"
  ],
  "graphs": {
    "chess": "./apps/server/langchain_chess_server/graph.py:make_graph"
  },
  "env": ".env",
  "auth": {
    "path": "./apps/server/langchain_chess_server/auth.py:auth",
    "allow_langsmith_api_keys": true
  },
  "http": {
    "app": "./apps/server/langchain_chess_server/app.py:app"
  }
}
