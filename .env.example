# Two LangSmith orgs. Traces go to one; every model call goes through the other's
# LLM Gateway. Provider secrets (TypeSafe, Anthropic, OpenAI) live in the gateway
# workspace, never here.
#
# Local commands that make model calls must load this file explicitly:
#   uv run --all-packages --env-file .env lcchess play
# `langgraph dev` reads it through langgraph.json.

# Tracing org (Deployed Engineering)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=jev-chess
# Pin the workspace the tracing key belongs to. Without this the SDK falls back to the
# `langsmith` CLI's current profile, which may be a different workspace and yields 403s.
LANGSMITH_WORKSPACE_ID=

# Gateway org (LangChain Inc.). One workspace-scoped key with gateway:invoke, exported
# in your shell as LC_GATEWAY_KEY. `uv run --env-file` and python-dotenv both expand
# ${VAR} from the parent environment, so the lines below reuse it.
# If LC_GATEWAY_KEY is missing, these expand to "" and langchain-core silently falls
# back to LANGSMITH_API_KEY, which routes model calls to the tracing org's gateway.
# The app refuses to start on an empty gateway key for that reason.
LANGSMITH_GATEWAY=true
LANGSMITH_GATEWAY_API_KEY=${LC_GATEWAY_KEY}
# System 1 (SemIf, Jev): langchain-typesafe posts to {TYPESAFE_BASE_URL}/v1/systemone.
# Use the gateway root: it serves both `semif-qwen3.5-4b` and Jev as `typesafe/jev-latest`
# (the bare `jev-latest` is a 404 there).
TYPESAFE_BASE_URL=https://gateway.smith.langchain.com
TYPESAFE_API_KEY=${LC_GATEWAY_KEY}
