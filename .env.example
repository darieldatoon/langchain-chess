# Traces go to one LangSmith workspace; every model call goes through a LangSmith LLM
# Gateway, which may belong to a different org. Provider secrets (TypeSafe, Anthropic,
# OpenAI) live in the gateway workspace, never here.
#
# Local commands that make model calls must load this file explicitly:
#   uv run --all-packages --env-file .env lcchess play
# `langgraph dev` reads it through langgraph.json.

# Tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# Local runs trace to the langchain-chess agent's local environment; the deployment reports
# into production. Don't also set LANGSMITH_PROJECT: with both, the SDK traces nothing.
LANGSMITH_AGENT_ID=langchain-chess
LANGSMITH_AGENT_ENVIRONMENT=local
# Pin the workspace the tracing key belongs to. Without this the SDK falls back to the
# `langsmith` CLI's current profile, which may be a different workspace and yields 403s.
LANGSMITH_WORKSPACE_ID=

# LLM Gateway: one workspace-scoped key with gateway:invoke, exported
# in your shell as LC_GATEWAY_KEY. `uv run --env-file` and python-dotenv both expand
# ${VAR} from the parent environment, so the lines below reuse it.
# If LC_GATEWAY_KEY is missing, these expand to "" and langchain-core silently falls
# back to LANGSMITH_API_KEY, which routes model calls to the tracing org's gateway.
# The app refuses to start on an empty gateway key for that reason.
LANGSMITH_GATEWAY=true
LANGSMITH_GATEWAY_API_KEY=${LC_GATEWAY_KEY}
# System 1: OpenAI Decisions (openai/gpt-6-luna) uses LANGSMITH_GATEWAY* above, like the
# chat models. Jev: langchain-typesafe posts to {TYPESAFE_BASE_URL}/v1/systemone.
# Use the gateway root: it serves Jev as `typesafe/jev-latest`
# (the bare `jev-latest` is a 404 there).
TYPESAFE_BASE_URL=https://gateway.smith.langchain.com
TYPESAFE_API_KEY=${LC_GATEWAY_KEY}

# Sign in with LangSmith (apps/web/README.md#sign-in): the OAuth app's client id and the org
# whose members may use the server. Unset, the server refuses sign-in tokens; keys still work.
OAUTH_CLIENT_ID=
ALLOWED_ORGANIZATION_ID=
