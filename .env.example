# All model calls (Jev and LLMs) go through the LangSmith LLM Gateway with one key.
# Provider secrets (TYPESAFE_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY) live in the
# LangSmith workspace, not here.
LANGSMITH_API_KEY=
LANGSMITH_GATEWAY=true
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=jev-chess

# absolute paths, or leave blank to search PATH
STOCKFISH_PATH=
LC0_PATH=
MAIA_WEIGHTS_DIR=engines/maia
