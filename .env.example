# Two LangSmith orgs are involved. Tracing goes to one, model calls go through the
# other's LLM Gateway. Provider secrets (TYPESAFE_API_KEY, ANTHROPIC_API_KEY,
# OPENAI_API_KEY) live in the gateway workspace, never here.

# Tracing: workspace-scoped key for the org that should receive traces.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=jev-chess
# Pin the workspace the tracing key belongs to. Without this the SDK falls back to the
# `langsmith` CLI's current profile, which may be a different workspace and yields 403s.
LANGSMITH_WORKSPACE_ID=

# LLM Gateway: workspace-scoped key with gateway:invoke in the org whose provider
# secrets should be billed. LangChain chat models read LANGSMITH_GATEWAY_API_KEY when
# LANGSMITH_GATEWAY is set; our Jev client reads it explicitly.
LANGSMITH_GATEWAY=true
LANGSMITH_GATEWAY_API_KEY=

# Engines: absolute paths, or leave blank to search PATH
STOCKFISH_PATH=
LC0_PATH=
MAIA_WEIGHTS_DIR=engines/maia
