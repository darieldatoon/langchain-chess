    {
      "id": "claim_da924ca86b624259b9fe4f9d0bcf3c46",
      "statement": "model_identity strips the langsmith: prefix, splits vendor:model on the colon, and for a vendor/model name the slash vendor wins over the provider argument (the gateway's ls_provider 'openai' is the transport); bare names fall back to the provider or 'unknown'. canonical_model formats vendor:model, the form stored in every Call.",
      "evidence": [
        {
          "resource": "repo://libs/chess/langchain_chess/models.py#L1-L26",
          "version": "repo-lines-v1:sha256:8240e2f8873ab853229664cf493dd3db629aeb178e8e1ca4f6efa3583a790092:"
