    {
      "id": "claim_5e2f0d166dac4074918d14a893926d0e",
      "statement": "CallRecorder records only inside a sink held in a ContextVar: ChessCore's wrap_model_call/awrap_model_call open sink('llm') around the handler and ChessSummarization's before_model/abefore_model open sink('summary'); every chat-model response inside, including inner retries and fallbacks, is appended and then added to the current turn's calls. Calls are never keyed by the callback run tree because tracing spans sit between node and provider.",
      "evidence": [
        {
          "resource": "repo://libs/chess/langchain_chess/middleware/core.py#L389-L468",
          "version": "repo-lines-v1:sha256:27aa58964e3b13331a43645a5f55fdfbfe89ec06f6005fd22efbfd93580fb25e:"
