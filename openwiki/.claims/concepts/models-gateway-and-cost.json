    {
      "id": "claim_83f35e061b544a33a139604b187b6cd2",
      "statement": "The server and CLI build chat models with init_chat_model using max_tokens=32000 (the cap covers reasoning), a name equal to the model_identity model part for trace spans, reasoning_effort only when it is not None (models without reasoning reject the parameter), and, only for langsmith: specs whose context window genai-prices knows, a profile with max_input_tokens equal to that window minus MAX_TOKENS because the gateway's ChatOpenAI has no profile; native providers' profiles are never replaced.",
      "evidence": [
        {
          "resource": "repo://apps/server/langchain_chess_server/graph.py#L22-L41",
          "version": "repo-lines-v1:sha256:55de16e11557ab4cc444be4eb15482c86e2c5f0f4e6d329ac8112e5d1fef13df:"
