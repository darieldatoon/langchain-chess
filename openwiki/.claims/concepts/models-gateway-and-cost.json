    {
      "id": "claim_1447d7220ba043e586a0069089d19d35",
      "statement": "create_chess_agent creates one CallRecorder, passes it to ChessCore and ChessSummarization, and attaches it to the compiled graph via with_config(callbacks=[recorder]).",
      "evidence": [
        {
          "resource": "repo://libs/chess/langchain_chess/agent.py#L89-L124",
          "version": "repo-lines-v1:sha256:f01c7cb7e4c61d01c8803f7a993a98b30232979baaf35a7605ec2b14ff0c6a45:"
        }
