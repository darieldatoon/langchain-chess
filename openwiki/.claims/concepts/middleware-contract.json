      "id": "claim_f9b5b00ea0924335ae28bddacf413aeb",
      "statement": "create_chess_agent wraps every user middleware with guard(), orders the stack as ChessCore, then ForcedMoveMiddleware (when forced_move), then the guarded extensions, then ChessSummarization (only for memory='summarize'), and builds the agent with create_agent(tools=[]).",
      "evidence": [
        {
          "resource": "repo://libs/chess/langchain_chess/agent.py#L80-L116",
          "version": "repo-lines-v1:sha256:e9c1ef96efb3d4afca00b7c672323259e550f527bebe5fa13c90422ea71b5526:"
        }
      ]
    },
    {
