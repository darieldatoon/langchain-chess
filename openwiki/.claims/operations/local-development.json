    {
      "id": "claim_64f9d3d12be44aa4b19129d0e5102977",
      "statement": "mise.toml is the single toolchain file: it pins node, pnpm, uv, lefthook, sfw, fastchess, Stockfish and the langsmith CLI, while Python comes from uv rather than mise.",
