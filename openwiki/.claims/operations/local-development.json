    {
      "id": "claim_f36296bec96a4a06a75918b42c414a51",
      "statement": "The setup task installs Python and web dependencies through Socket Firewall (sfw uv sync --all-packages --all-groups, sfw pnpm install --frozen-lockfile) and then installs git hooks with lefthook install.",
