    {
      "id": "claim_c109959fdcfc49c985db8a2aa0272848",
      "statement": "The review app is published by a separate deploy-review.yml whose tip job requires main and a non-empty CUSTOM_APP_ID repository variable; the review job writes apps/review/.langsmith/app.json from that variable (name langchain-chess-review) and runs langsmith apps push with LANGSMITH_API_KEY.",
      "evidence": [
