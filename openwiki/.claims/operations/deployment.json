    {
      "id": "claim_10c5095247c84c1dbfa85c0085595c1c",
      "statement": "The agent deploy job writes a .env with LANGSMITH_GATEWAY, LANGSMITH_GATEWAY_API_KEY, TYPESAFE_BASE_URL and TYPESAFE_API_KEY (keys from the LC_GATEWAY_KEY secret) because langgraph deploy re-sends the env file as the revision's secrets on every deploy, then runs mise run deploy -- --no-input with the LANGSMITH_API_KEY secret.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/deploy.yml#L83-L114",
