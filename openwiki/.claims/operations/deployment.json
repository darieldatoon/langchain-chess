    {
      "id": "claim_124cb4581f8d4ceeb83e3dfa5cfd8198",
      "statement": "Before deploying, each deploy job fetches current main and runs scripts/superseded.sh, which reads the workflow's on.push.paths from main's copy, converts them to :(glob) pathspecs and diffs the tested SHA against main; any matching change fails the job with an instruction to re-run all jobs, preventing a re-run of only the deploy job from shipping a stale commit.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/deploy-review.yml#L78-L92",
          "version": "repo-lines-v1:sha256:96d5d340c9d1e50baf22a6198b64bb32362c6cd3da47c2da455f3dec9cec6608:"
