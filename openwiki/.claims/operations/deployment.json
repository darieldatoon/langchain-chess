    {
      "id": "claim_7280907bf76e4b558e380cfd95197bea",
      "statement": "deploy.yml (agent) and deploy-review.yml (review) each run on push to main filtered by on.push.paths and on workflow_dispatch without inputs, which ignores the path filters; the jobs run only on refs/heads/main, so a dispatch from another branch skips.",
