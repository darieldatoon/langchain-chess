    {
      "id": "claim_29c8416aed0f4109b6eedb1a8b2ecad5",
      "statement": "Each deploy workflow holds a workflow-level concurrency group per ref (deploy-agent-<ref>, deploy-review-<ref>) with queue: max, so the whole run including CI is serialized in push order and a newer run never cancels a pending deploy; ci.yml instead uses a group keyed on PR number or run id with cancel-in-progress true, so a new merge never cancels a deploy's checks.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/ci.yml#L17-L20",
          "version": "repo-lines-v1:sha256:4150fec04a672cfa8134f3cd03fe13ad83f9547719fd4bde973b2099a7471d97:"
