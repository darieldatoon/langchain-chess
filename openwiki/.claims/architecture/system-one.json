  "claims": [
    {
      "id": "claim_24775040fdd443d9b08928d1e4881de0",
      "statement": "SystemOneMiddleware plays System 1's top move only when threshold < 1.0 and the gate signal (margin p1-p2 by default, or Choice confidence) is at least the threshold; otherwise it writes a top-k (or top_p prefix capped at k) shortlist as soft candidates, so threshold 0 always plays and threshold 1 never plays.",
      "evidence": [
        {
          "resource": "repo://libs/systemone/langchain_chess_systemone/middleware.py#L120-L161",
          "version": "repo-lines-v1:sha256:dfbc8041abe0dea2fa29bdc7586668d670fdd2485f854bd0cedbf7463fe82f41:"
        },
        {
          "resource": "repo://libs/systemone/tests/test_middleware.py#L210-L224",
          "version": "repo-lines-v1:sha256:1ae5672105f66f9ffa8ec2048ac6322d798fc1195e5d7bbfae735c50a2c22dc0:"
        }
      ]
    },
    {
      "id": "claim_fb89c12234ab413c8bc5ce85c6703101",
      "statement": "After a tournament, tournament_threshold replaces threshold when set (otherwise threshold applies), because a final over fewer moves inflates the margin and SemIf confidence depends on option count; the applied value is recorded as threshold_used.",
