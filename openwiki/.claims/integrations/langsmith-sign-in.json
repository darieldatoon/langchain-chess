  "claims": [
    {
      "id": "claim_85161f93b8de4483a9fdb46b15f9c351",
      "statement": "langgraph.json registers auth.py:auth as the Agent Server auth handler and sets allow_langsmith_api_keys, so requests without an Authorization header are checked by LangSmith's own API-key check and never reach the handler.",
      "evidence": [
        {
          "resource": "repo://apps/server/langchain_chess_server/auth.py#L1-L7",
          "version": "repo-lines-v1:sha256:1f8ca325e3c5df959f1539d92b881c234c118499f6a7b16ccb32537e061a11ec:"
        },
        {
          "resource": "repo://langgraph.json#L20-L23",
          "version": "repo-lines-v1:sha256:f33a570b10658ab7387cf72803da7879566f2cbde73f72eae17c54e000f83c9f:"
        }
      ]
    },
    {
      "id": "claim_b2577ac512994a97ba63adec9dcbc0e0",
      "statement": "The server verifies bearer tokens as EdDSA JWTs using signing keys fetched from https://api.smith.langchain.com/.well-known/jwks.json, requiring iss and aud to equal https://api.smith.langchain.com and requiring exp, iss, aud and sub; any verification error yields 401.",
      "evidence": [
        {
          "resource": "repo://apps/server/langchain_chess_server/auth.py#L20-L21",
          "version": "repo-lines-v1:sha256:b4dd667277a479639aa54b4f7086d6f5ddbdc9ab15db3667a6e426e928dc6efc:"
        },
        {
