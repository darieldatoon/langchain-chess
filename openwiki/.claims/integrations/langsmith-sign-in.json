          "version": "repo-lines-v1:sha256:e89db53860dfdb88e8a7b5ed04c7599ab28559cb6caeb38f70654004ae881230:"
        }
      ]
    },
    {
      "id": "claim_8065e09f30b04057955378cc968fc66f",
      "statement": "A missing, non-Bearer, or empty Authorization header yields 401, while a verified token whose client_id or organization_id does not match the access policy yields 403; an admitted token's identity is its sub claim.",
      "evidence": [
        {
          "resource": "repo://apps/server/langchain_chess_server/auth.py#L39-L76",
          "version": "repo-lines-v1:sha256:5f55c45779a45a2787c1388de4deb6c21effee3ada3a79fce97e10aff9a15c53:"
