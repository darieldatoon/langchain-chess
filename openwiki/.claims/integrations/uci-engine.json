    {
      "id": "claim_fb1339a8e1e84977a4481c8ecc822649",
      "statement": "`go infinite` and `go ponder` searches are held: a finished result is not printed until `stop` or `ponderhit`; `ponderhit` converts the search to a normal one, settling immediately if done or arming a deadline otherwise; stop/ponderhit without an active held search are no-ops.",
      "evidence": [
        {
