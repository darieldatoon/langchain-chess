    {
      "id": "claim_9958fcea0eff4a36aa2850fca65d5da2",
      "statement": "Completion rows are checked in order: a committed ply of the search's own request wins (even if cancelled), then resignation or other terminal outcome (bestmove 0000 with info reason), then a rejected position (bestmove 0000), then a fallback move.",
      "evidence": [
        {
          "resource": "repo://libs/cli/langchain_chess_cli/uci/completion.py#L56-L76",
          "version": "repo-lines-v1:sha256:524f2b980bb073f89688616673398423535b67f18e47e984356c3b73d65d5017:"
