    {
      "id": "claim_1df835d94760452295ba3810bdc75772",
      "statement": "The UCI engine allows at most one active search; `go`, `ucinewgame` and `quit` first retire (cancel and settle) any active search, so the old search prints its bestmove before a new one starts.",
      "evidence": [
        {
          "resource": "repo://libs/cli/langchain_chess_cli/uci/engine.py#L195-L231",
          "version": "repo-lines-v1:sha256:08e1512d8f415918cf8a9e412f6cfcdaaee66834c27d1490ff88e3402c9adb0b:"
