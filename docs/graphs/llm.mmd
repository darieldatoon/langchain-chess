---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	prepare(prepare)
	call_llm(call_llm)
	parse(parse)
	feedback(feedback)
	fallback(fallback)
	decide(decide)
	__end__([<p>__end__</p>]):::last
	__start__ --> prepare;
	call_llm --> parse;
	fallback --> decide;
	feedback --> call_llm;
	parse -.-> decide;
	parse -.-> fallback;
	parse -.-> feedback;
	prepare --> call_llm;
	decide --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
