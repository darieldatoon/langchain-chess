# Build context for `langgraph build` / `langgraph deploy --no-remote`. The uv workspace (libs/,
# apps/server/, the lockfile) and the web build under apps/server/langchain_chess_server/static
# are all the image needs. Docker semantics only: a gitignored static/ still gets in, which is
# what CI relies on.
.git/
.venv/
**/node_modules/
**/__pycache__/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.env
.env.*
!.env.example
*.pem
*.key
*.crt
credentials.json
plans/
docs/
**/tests/
apps/web/
packages/
.uci-match/
.langgraph_api/
.DS_Store
.github/
